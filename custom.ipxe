#!ipxe

:custom_menu
# 标题必须用双引号括起来
menu "--- LINUX MINT SELECTION ---"
item --gap --             "==============================================="
item --gap --             "VERSION SELECTION:"
item mint_22_3_menu       " [22.3]  Linux Mint 22.3 (Zena) - Latest"
item mint_22_1_menu       " [22.1]  Linux Mint 22.1 (Xia)  - Stable"
item --gap --             "==============================================="
item --gap --             "CONTROL:"
item return               " [BACK]  Return to Main Menu"
choose target && goto ${target}

:mint_22_3_menu
menu "--- LINUX MINT 22.3 EDITIONS ---"
item --gap --             "Select Desktop Environment:"
item mint_22_3_cinnamon    "  > Cinnamon Edition (Modern)"
item mint_22_3_mate        "  > MATE Edition     (Classic)"
item mint_22_3_xfce        "  > XFCE Edition     (Lightweight)"
item --gap --             
item custom_menu           " [BACK]  Back to Version Selection"
choose target && goto ${target}

:mint_22_1_menu
menu "--- LINUX MINT 22.1 EDITIONS ---"
item --gap --             "Select Desktop Environment:"
item mint_22_1_cinnamon    "  > Cinnamon Edition"
item mint_22_1_mate        "  > MATE Edition"
item mint_22_1_xfce        "  > XFCE Edition"
item --gap --             
item custom_menu           " [BACK]  Back to Version Selection"
choose target && goto ${target}

# --- 引导逻辑保持不变 ---
:mint_22_3_cinnamon
set iso_url http://netcologne.de
goto boot_iso

:mint_22_3_mate
set iso_url http://netcologne.de
goto boot_iso

:mint_22_3_xfce
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_cinnamon
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_mate
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_xfce
set iso_url http://netcologne.de
goto boot_iso

:boot_iso
kernel https://netboot.xyz iso raw
initrd ${iso_url}
boot

:return
chain --autofree menu.ipxe
