#!ipxe

:custom_menu
menu --- [ LINUX MINT DISTRIBUTION SELECTOR ] ---
item --gap --             ************************************************
item --gap --             >> STEP 1: SELECT LINUX MINT VERSION
item --gap --             ************************************************
item mint_22_3_menu       [V] Linux Mint 22.3 (Zena) -- LATEST VERSION
item mint_22_1_menu       [V] Linux Mint 22.1 (Xia)  -- PREVIOUS STABLE
item --gap --             
item --gap --             >> SYSTEM OPTIONS
item return               [X] RETURN TO NETBOOT.XYZ MAIN MENU
choose target && goto ${target}

# --- 22.3 子菜单 ---
:mint_22_3_menu
menu --- [ EDITION: LINUX MINT 22.3 (ZENA) ] ---
item --gap --             Available Desktop Environments:
item mint_22_3_cinnamon    +-- CINNAMON (Modern, Sleek)
item mint_22_3_mate        +-- MATE     (Traditional, Fast)
item mint_22_3_xfce        +-- XFCE     (Lightweight, Stable)
item --gap --             
item custom_menu          [B] BACK TO VERSION SELECTION
choose target && goto ${target}

# --- 22.1 子菜单 ---
:mint_22_1_menu
menu --- [ EDITION: LINUX MINT 22.1 (XIA) ] ---
item --gap --             Available Desktop Environments:
item mint_22_1_cinnamon    +-- CINNAMON (Default)
item mint_22_1_mate        +-- MATE     (Classic)
item mint_22_1_xfce        +-- XFCE     (Lite)
item --gap --             
item custom_menu          [B] BACK TO VERSION SELECTION
choose target && goto ${target}

# --- 引导逻辑 ---
:mint_22_3_cinnamon
set iso_url http://netcologne.de
goto boot_iso

:mint_22_3_mate
set iso_url http://netcologne.de
goto boot_iso

:mint_22_3_xfce
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_cinnamon
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_mate
set iso_url http://netcologne.de
goto boot_iso

:mint_22_1_xfce
set iso_url http://netcologne.de
goto boot_iso

:boot_iso
echo Loading Linux Mint from: ${iso_url}
kernel https://netboot.xyz iso raw
initrd ${iso_url}
boot

:return
chain --autofree menu.ipxe
